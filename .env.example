# Firebase web app config: Firebase console > Project settings > Your apps > Web app.
# Copy this file to .env and fill in the values. Never commit .env.
# EXPO_PUBLIC_ values are bundled into the app, so never put real secrets here.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
